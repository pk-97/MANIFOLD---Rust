target/
*.manifold
**/.DS_Store
# Worktree-pool lease (scripts/agent-worktree.py) — session-local claim marker,
# lives at each worktree's root; mtime is the staleness clock.
.worktree-lease.json
# Runtime diagnostic logs from MANIFOLD_LOG_CHAIN_STATS etc.
chain-stats.log
*.log
*.candidate.txt
.codex/tmp/
.codex/scratch/
.codex/*.local.md
assets/mri-data/
profiling_sessions/
__pycache__/
.venv/
# .claude is versioned selectively: hooks, skills and settings have history;
# local state stays ignored.
.claude/*
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
.claude/settings.local.json

# Real-audio eval fixtures for the mod_harness (copyrighted clips — never commit)
tests/fixtures/audio/

# Khronos glTF-Sample-Assets conformance fixtures (GLB_CONFORMANCE_DESIGN.md
# D1) — fetched by scripts/fetch-gltf-conformance.sh from a pinned commit,
# never vendored (mixed licenses, hundreds of MB across the full suite).
# manifest.json itself (the pin + per-asset checks) stays tracked.
tests/fixtures/gltf/khronos/*
!tests/fixtures/gltf/khronos/manifest.json

# G-P6 HDRI demo material (Poly Haven CC0, fetched by
# scripts/fetch-gltf-conformance.sh) — kept untracked for repo size,
# never vendored (audit table, GLB_CONFORMANCE_DESIGN.md §1).
tests/fixtures/gltf/kloppenheim_07_puresky_4k.exr

# Peter drops downloaded look-test GLBs/FBXs (large, licensing unvetted) straight
# into this folder — blanket-ignore them so they never read as dirt in
# worktree slots (untracked-but-not-ignored files wedge the ring: the slot
# never returns to idle; bit 2026-07-17). Already-tracked fixtures
# (DamagedHelmet, the blossom set, …) are unaffected — gitignore only
# applies to untracked files. To deliberately track a NEW fixture, use
# `git add -f` or add a `!tests/fixtures/gltf/<name>.glb` exception here.
tests/fixtures/gltf/*.glb
tests/fixtures/gltf/*.fbx
tests/fixtures/gltf/drogon__game_of_thrones_dragon/

# Ocean Cliff preset assets (Poly Haven CC0, OCEAN_SURFACE_DESIGN.md section 8).
tests/fixtures/gltf/coastal_cliff_02/
tests/fixtures/hdri/umhlanga_sunrise_4k.exr
tests/fixtures/hdri/kloppenheim_06_puresky_4k.exr

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Session-resume state written next to .manifold files (machine-local)
*.breadcrumb
# Local copies of recent show projects and their assets
tests/fixtures/projects/
