{
  "version": 3,
  "name": "Scene Loop",
  "presetMetadata": {
    "id": "SceneLoop",
    "displayName": "Scene Loop",
    "category": "Geometry",
    "oscPrefix": "scene_loop",
    "available": true,
    "params": [
      {
        "id": "pattern_length",
        "name": "Pattern",
        "min": 1.0,
        "max": 8.0,
        "defaultValue": 1.0,
        "wholeNumbers": true
      },
      {
        "id": "jitter_amount",
        "name": "Jitter",
        "min": 0.0,
        "max": 1.0,
        "defaultValue": 0.0
      },
      {
        "id": "enabled",
        "name": "Enabled",
        "min": 0.0,
        "max": 1.0,
        "defaultValue": 1.0,
        "isToggle": true
      }
    ],
    "bindings": [
      {
        "id": "pattern_length",
        "label": "Pattern",
        "defaultValue": 1.0,
        "target": {
          "kind": "node",
          "nodeId": "scene_array",
          "param": "pattern_length"
        }
      },
      {
        "id": "jitter_amount",
        "label": "Jitter",
        "defaultValue": 0.0,
        "target": {
          "kind": "node",
          "nodeId": "scene_array",
          "param": "jitter_amount"
        }
      },
      {
        "id": "enabled",
        "label": "Enabled",
        "defaultValue": 1.0,
        "target": {
          "kind": "node",
          "nodeId": "loop_switch",
          "param": "selector"
        }
      }
    ],
    "sceneModifier": {
      "schemaVersion": 1,
      "singleton": true,
      "enabledParam": "enabled",
      "preparationParams": [],
      "stages": [
        {
          "group": "loop_corridor_stage",
          "scope": "scene",
          "inputs": [
            {
              "port": "camera",
              "source": {
                "previous": {
                  "endpoint": "camera"
                }
              }
            },
            {
              "port": "cell_size",
              "source": {
                "context": {
                  "value": "loopCell"
                }
              }
            }
          ],
          "outputs": []
        },
        {
          "group": "loop_instances_stage",
          "scope": "eachObject",
          "inputs": [
            {
              "port": "instances",
              "source": {
                "stageOutput": {
                  "stage": "loop_corridor_stage",
                  "port": "instances"
                }
              }
            },
            {
              "port": "previous",
              "source": {
                "previous": {
                  "endpoint": "instances"
                }
              }
            }
          ],
          "outputs": [
            {
              "port": "instances",
              "endpoint": "instances"
            }
          ]
        }
      ]
    }
  },
  "nodes": [
    {
      "id": 1,
      "nodeId": "loop_corridor_stage",
      "typeId": "group",
      "handle": "SceneLoopCorridorStage",
      "group": {
        "interface": {
          "inputs": [
            {
              "name": "camera",
              "portType": "Camera"
            },
            {
              "name": "cell_size",
              "portType": "Scalar(F32)"
            }
          ],
          "outputs": [
            {
              "name": "instances",
              "portType": "Array(InstanceTransform)"
            }
          ]
        },
        "nodes": [
          {
            "id": 1,
            "nodeId": "group_camera",
            "typeId": "system.group_input",
            "handle": "camera"
          },
          {
            "id": 2,
            "nodeId": "scene_array",
            "typeId": "node.scene_array",
            "handle": "scene_array",
            "params": {
              "pattern_length": {
                "type": "Int",
                "value": 1
              },
              "axis": {
                "type": "Enum",
                "value": 4
              },
              "cell_size": {
                "type": "Float",
                "value": 10.0
              },
              "jitter_seed": {
                "type": "Int",
                "value": 0
              },
              "jitter_amount": {
                "type": "Float",
                "value": 0.0
              }
            }
          },
          {
            "id": 3,
            "nodeId": "loop_corridor_output",
            "typeId": "system.group_output",
            "handle": "output"
          },
          {
            "id": 4,
            "nodeId": "group_cell_size",
            "typeId": "system.group_input",
            "handle": "cell_size"
          }
        ],
        "wires": [
          {
            "fromNode": 1,
            "fromPort": "camera",
            "toNode": 2,
            "toPort": "camera"
          },
          {
            "fromNode": 4,
            "fromPort": "cell_size",
            "toNode": 2,
            "toPort": "cell_size"
          },
          {
            "fromNode": 2,
            "fromPort": "out",
            "toNode": 3,
            "toPort": "instances"
          }
        ]
      }
    },
    {
      "id": 2,
      "nodeId": "loop_instances_stage",
      "typeId": "group",
      "handle": "SceneLoopInstancesStage",
      "group": {
        "interface": {
          "inputs": [
            {
              "name": "instances",
              "portType": "Array(InstanceTransform)"
            },
            {
              "name": "previous",
              "portType": "Array(InstanceTransform)"
            }
          ],
          "outputs": [
            {
              "name": "instances",
              "portType": "Array(InstanceTransform)"
            }
          ]
        },
        "nodes": [
          {
            "id": 1,
            "nodeId": "group_instances",
            "typeId": "system.group_input",
            "handle": "instances"
          },
          {
            "id": 2,
            "nodeId": "group_previous",
            "typeId": "system.group_input",
            "handle": "previous"
          },
          {
            "id": 3,
            "nodeId": "loop_switch",
            "typeId": "node.switch_instances",
            "handle": "loop_switch",
            "params": {
              "selector": {
                "type": "Float",
                "value": 1.0
              }
            }
          },
          {
            "id": 4,
            "nodeId": "loop_instances_output",
            "typeId": "system.group_output",
            "handle": "output"
          }
        ],
        "wires": [
          {
            "fromNode": 2,
            "fromPort": "previous",
            "toNode": 3,
            "toPort": "in_0"
          },
          {
            "fromNode": 1,
            "fromPort": "instances",
            "toNode": 3,
            "toPort": "in_1"
          },
          {
            "fromNode": 3,
            "fromPort": "out",
            "toNode": 4,
            "toPort": "instances"
          }
        ]
      }
    }
  ],
  "wires": []
}
