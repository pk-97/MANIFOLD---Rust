  "wires": [
    { "fromNode": 1, "fromPort": "out", "toNode": 7, "toPort": "camera" },
    { "fromNode": 2, "fromPort": "envmap", "toNode": 7, "toPort": "envmap" },
    { "fromNode": 3, "fromPort": "vertices", "toNode": 6, "toPort": "vertices" },
    { "fromNode": 3, "fromPort": "material", "toNode": 6, "toPort": "material" },
    { "fromNode": 3, "fromPort": "transform", "toNode": 6, "toPort": "transform" },
    { "fromNode": 4, "fromPort": "out", "toNode": 7, "toPort": "light_0" },
    { "fromNode": 5, "fromPort": "out", "toNode": 4, "toPort": "intensity" },
    { "fromNode": 6, "fromPort": "object", "toNode": 7, "toPort": "object_0" },
    { "fromNode": 7, "fromPort": "color", "toNode": 8, "toPort": "in" }
  ]
