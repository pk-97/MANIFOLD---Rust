      "nodeId": "camera",
      "typeId": "node.orbit_camera",
      "handle": "camera",
      "params": {
        "distance": { "type": "Float", "value": 5.0 },
        "fov_y": { "type": "Float", "value": 0.9 },
        "look_y": { "type": "Float", "value": 0.5 },
        "orbit": { "type": "Float", "value": 0.7 },
        "tilt": { "type": "Float", "value": 0.35 }
      }
    },
