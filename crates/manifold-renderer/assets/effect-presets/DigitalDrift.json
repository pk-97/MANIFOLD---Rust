{
  "version": 2,
  "name": "DigitalDrift",
  "presetMetadata": {
    "id": "DigitalDrift",
    "displayName": "Digital Drift",
    "category": "Stylize",
    "oscPrefix": "digitaldrift",
    "available": true,
    "params": [
      {
        "id": "amount",
        "name": "Drift",
        "min": 0.0,
        "max": 1.0,
        "defaultValue": 1.0,
        "wholeNumbers": false,
        "isToggle": false,
        "formatString": "F2"
      },
      {
        "id": "speed",
        "name": "Speed",
        "min": 0.1,
        "max": 10.0,
        "defaultValue": 2.0,
        "wholeNumbers": false,
        "isToggle": false,
        "formatString": "F2",
        "oscSuffix": "Speed"
      },
      {
        "id": "bands",
        "name": "Bands",
        "min": 0.0,
        "max": 128.0,
        "defaultValue": 36.0,
        "wholeNumbers": true,
        "isToggle": false,
        "formatString": "F0",
        "oscSuffix": "Bands"
      },
      {
        "id": "spread",
        "name": "Band Gap",
        "min": 0.0,
        "max": 2.0,
        "defaultValue": 0.0,
        "wholeNumbers": false,
        "isToggle": false,
        "formatString": "F2",
        "oscSuffix": "BandGap"
      },
      {
        "id": "gap_mode",
        "name": "Gap Mode",
        "min": 0.0,
        "max": 1.0,
        "defaultValue": 0.0,
        "wholeNumbers": true,
        "isToggle": false,
        "formatString": "F0",
        "oscSuffix": "GapMode"
      },
      {
        "id": "angle",
        "name": "Slice Angle",
        "min": 0.0,
        "max": 180.0,
        "defaultValue": 0.0,
        "wholeNumbers": true,
        "isToggle": false,
        "formatString": "F0",
        "oscSuffix": "SliceAngle"
      },
      {
        "id": "rgb_shift",
        "name": "RGB Shift",
        "min": 0.0,
        "max": 0.03,
        "defaultValue": 0.008,
        "wholeNumbers": false,
        "isToggle": false,
        "formatString": "F2",
        "oscSuffix": "RGBShift"
      }
    ],
    "bindings": [
      {
        "id": "amount",
        "label": "Drift",
        "defaultValue": 1.0,
        "target": { "kind": "node", "nodeId": "drift_amount", "param": "value" },
        "convert": { "type": "Float" }
      },
      {
        "id": "speed",
        "label": "Speed",
        "defaultValue": 2.0,
        "target": { "kind": "node", "nodeId": "speed_value", "param": "value" },
        "convert": { "type": "Float" }
      },
      {
        "id": "bands",
        "label": "Bands",
        "defaultValue": 36.0,
        "target": { "kind": "node", "nodeId": "rows", "param": "bands" },
        "convert": { "type": "Float" }
      },
      {
        "id": "spread",
        "label": "Band Gap",
        "defaultValue": 0.0,
        "target": { "kind": "node", "nodeId": "rows", "param": "spread" },
        "convert": { "type": "Float" }
      },
      {
        "id": "gap_mode",
        "label": "Gap Mode",
        "defaultValue": 0.0,
        "target": { "kind": "node", "nodeId": "rows", "param": "spread_mode" },
        "convert": { "type": "EnumRound" }
      },
      {
        "id": "angle",
        "label": "Slice Angle",
        "defaultValue": 0.0,
        "target": { "kind": "node", "nodeId": "rows", "param": "angle" },
        "convert": { "type": "Float" }
      },
      {
        "id": "angle",
        "label": "Slice Angle",
        "defaultValue": 0.0,
        "target": { "kind": "node", "nodeId": "split_dir", "param": "angle" },
        "convert": { "type": "Float" }
      },
      {
        "id": "rgb_shift",
        "label": "RGB Shift",
        "defaultValue": 0.008,
        "target": { "kind": "node", "nodeId": "split", "param": "amount" },
        "convert": { "type": "Float" },
        "scale": -1000.0
      }
    ]
  },
  "nodes": [
    { "id": 0, "typeId": "system.source", "handle": "source", "nodeId": "source" },
    { "id": 1, "typeId": "system.generator_input", "handle": "gen_in", "nodeId": "gen_in" },
    {
      "id": 2,
      "typeId": "node.value",
      "handle": "drift_amount", "nodeId": "drift_amount",
      "title": "Drift",
      "params": {
        "value": { "type": "Float", "value": 1.0 }
      }
    },
    {
      "id": 3,
      "typeId": "node.value",
      "handle": "speed_value", "nodeId": "speed_value",
      "title": "Speed",
      "params": {
        "value": { "type": "Float", "value": 2.0 }
      }
    },
    {
      "id": 4,
      "typeId": "group",
      "handle": "Drift Field", "nodeId": "Drift Field",
      "group": {
        "interface": {
          "inputs": [
            { "name": "time", "portType": "Scalar(F32)" },
            { "name": "speed", "portType": "Scalar(F32)" },
            { "name": "amount", "portType": "Scalar(F32)" }
          ],
          "outputs": [
            { "name": "offset", "portType": "Texture2D" }
          ]
        },
        "nodes": [
          { "id": 0, "typeId": "system.group_input" },
          {
            "id": 1,
            "typeId": "node.math",
            "handle": "flow_clock", "nodeId": "flow_clock",
            "title": "time * speed",
            "params": {
              "op": { "type": "Enum", "value": 2 }
            }
          },
          {
            "id": 2,
            "typeId": "node.math",
            "handle": "t_pos", "nodeId": "t_pos",
            "title": "+t (clock * 0.065)",
            "params": {
              "op": { "type": "Enum", "value": 2 },
              "b": { "type": "Float", "value": 0.065 }
            }
          },
          {
            "id": 3,
            "typeId": "node.math",
            "handle": "t_neg", "nodeId": "t_neg",
            "title": "-t (clock * -0.065)",
            "params": {
              "op": { "type": "Enum", "value": 2 },
              "b": { "type": "Float", "value": -0.065 }
            }
          },
          {
            "id": 4,
            "typeId": "node.noise",
            "handle": "flow_a", "nodeId": "flow_a",
            "title": "value_noise(uv*3 + t)",
            "params": {
              "type": { "type": "Enum", "value": 3 },
              "scale": { "type": "Float", "value": 3.0 }
            }
          },
          {
            "id": 5,
            "typeId": "node.noise",
            "handle": "flow_b", "nodeId": "flow_b",
            "title": "value_noise(uv*3 - t)",
            "params": {
              "type": { "type": "Enum", "value": 3 },
              "scale": { "type": "Float", "value": 3.0 }
            }
          },
          {
            "id": 6,
            "typeId": "node.pack_rgba",
            "handle": "flow_pack", "nodeId": "flow_pack",
            "title": "pack R=x-noise G=y-noise"
          },
          {
            "id": 7,
            "typeId": "node.scale_offset_image",
            "handle": "flow_offset", "nodeId": "flow_offset",
            "title": "(noise - 0.5) * 0.028",
            "params": {
              "scale": { "type": "Float", "value": 0.028 },
              "offset": { "type": "Float", "value": -0.014 }
            }
          },
          {
            "id": 8,
            "typeId": "node.scanline_jitter_field",
            "handle": "rows", "nodeId": "rows",
            "title": "Slide rows",
            "params": {
              "amount": { "type": "Float", "value": 0.0 },
              "scanline": { "type": "Float", "value": 0.3 },
              "speed": { "type": "Float", "value": 2.0 },
              "motion": { "type": "Enum", "value": 1 },
              "bands": { "type": "Float", "value": 36.0 }
            }
          },
          {
            "id": 9,
            "typeId": "node.mix",
            "handle": "sum_offset", "nodeId": "sum_offset",
            "title": "flow + slide",
            "params": {
              "amount": { "type": "Float", "value": 1.0 },
              "mode": { "type": "Enum", "value": 2 }
            }
          },
          { "id": 10, "typeId": "system.group_output" }
        ],
        "wires": [
          { "fromNode": 0, "fromPort": "time", "toNode": 1, "toPort": "a" },
          { "fromNode": 0, "fromPort": "speed", "toNode": 1, "toPort": "b" },
          { "fromNode": 1, "fromPort": "out", "toNode": 2, "toPort": "a" },
          { "fromNode": 1, "fromPort": "out", "toNode": 3, "toPort": "a" },
          { "fromNode": 2, "fromPort": "out", "toNode": 4, "toPort": "offset_x" },
          { "fromNode": 2, "fromPort": "out", "toNode": 4, "toPort": "offset_y" },
          { "fromNode": 3, "fromPort": "out", "toNode": 5, "toPort": "offset_x" },
          { "fromNode": 3, "fromPort": "out", "toNode": 5, "toPort": "offset_y" },
          { "fromNode": 4, "fromPort": "out", "toNode": 6, "toPort": "r" },
          { "fromNode": 5, "fromPort": "out", "toNode": 6, "toPort": "g" },
          { "fromNode": 6, "fromPort": "out", "toNode": 7, "toPort": "in" },
          { "fromNode": 7, "fromPort": "out", "toNode": 9, "toPort": "a" },
          { "fromNode": 0, "fromPort": "amount", "toNode": 8, "toPort": "amount" },
          { "fromNode": 0, "fromPort": "speed", "toNode": 8, "toPort": "speed" },
          { "fromNode": 8, "fromPort": "offset", "toNode": 9, "toPort": "b" },
          { "fromNode": 9, "fromPort": "out", "toNode": 10, "toPort": "offset" }
        ]
      }
    },
    {
      "id": 5,
      "typeId": "group",
      "handle": "Warp & Split", "nodeId": "Warp & Split",
      "group": {
        "interface": {
          "inputs": [
            { "name": "source", "portType": "Texture2D" },
            { "name": "offset", "portType": "Texture2D" }
          ],
          "outputs": [
            { "name": "out", "portType": "Texture2D" }
          ]
        },
        "nodes": [
          { "id": 0, "typeId": "system.group_input" },
          {
            "id": 1,
            "typeId": "node.remap",
            "handle": "warp", "nodeId": "warp",
            "title": "warp source by offset",
            "params": {
              "wrap": { "type": "Enum", "value": 0 },
              "mode": { "type": "Enum", "value": 1 }
            }
          },
          {
            "id": 2,
            "typeId": "node.radial_offset_field",
            "handle": "split_dir", "nodeId": "split_dir",
            "title": "horizontal split direction",
            "params": {
              "mode": { "type": "Enum", "value": 1 },
              "angle": { "type": "Float", "value": 0.0 },
              "falloff": { "type": "Float", "value": 0.5 }
            }
          },
          {
            "id": 3,
            "typeId": "node.rgb_split",
            "handle": "split", "nodeId": "split",
            "title": "RGB channel split",
            "params": {
              "amount": { "type": "Float", "value": -8.0 }
            }
          },
          {
            "id": 5,
            "typeId": "node.channel_mixer",
            "handle": "mask_proj", "nodeId": "mask_proj",
            "title": "coverage mask = field B",
            "params": {
              "row0": { "type": "Vec4", "value": [0.0, 0.0, 1.0, 0.0] },
              "row1": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 0.0] },
              "row2": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 0.0] },
              "row3": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 0.0] }
            }
          },
          {
            "id": 6,
            "typeId": "node.channel_mixer",
            "handle": "transparent", "nodeId": "transparent",
            "title": "transparent black",
            "params": {
              "row0": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 0.0] },
              "row1": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 0.0] },
              "row2": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 0.0] },
              "row3": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 0.0] }
            }
          },
          {
            "id": 7,
            "typeId": "node.masked_mix",
            "handle": "gap_apply", "nodeId": "gap_apply",
            "title": "apply gap mask",
            "params": {
              "amount": { "type": "Float", "value": 1.0 }
            }
          },
          { "id": 4, "typeId": "system.group_output" }
        ],
        "wires": [
          { "fromNode": 0, "fromPort": "source", "toNode": 1, "toPort": "source" },
          { "fromNode": 0, "fromPort": "offset", "toNode": 1, "toPort": "uv_field" },
          { "fromNode": 1, "fromPort": "out", "toNode": 3, "toPort": "in" },
          { "fromNode": 2, "fromPort": "out", "toNode": 3, "toPort": "velocity" },
          { "fromNode": 0, "fromPort": "offset", "toNode": 5, "toPort": "source" },
          { "fromNode": 0, "fromPort": "source", "toNode": 6, "toPort": "source" },
          { "fromNode": 3, "fromPort": "out", "toNode": 7, "toPort": "b" },
          { "fromNode": 6, "fromPort": "out", "toNode": 7, "toPort": "a" },
          { "fromNode": 5, "fromPort": "out", "toNode": 7, "toPort": "mask" },
          { "fromNode": 7, "fromPort": "out", "toNode": 4, "toPort": "out" }
        ]
      }
    },
    {
      "id": 6,
      "typeId": "node.mix",
      "handle": "crossfade", "nodeId": "crossfade",
      "title": "crossfade over source",
      "params": {
        "amount": { "type": "Float", "value": 1.0 },
        "mode": { "type": "Enum", "value": 0 }
      }
    },
    { "id": 7, "typeId": "system.final_output", "handle": "final_output", "nodeId": "final_output" }
  ],
  "wires": [
    { "fromNode": 1, "fromPort": "time", "toNode": 4, "toPort": "time" },
    { "fromNode": 3, "fromPort": "out", "toNode": 4, "toPort": "speed" },
    { "fromNode": 2, "fromPort": "out", "toNode": 4, "toPort": "amount" },
    { "fromNode": 4, "fromPort": "offset", "toNode": 5, "toPort": "offset" },
    { "fromNode": 0, "fromPort": "out", "toNode": 5, "toPort": "source" },
    { "fromNode": 5, "fromPort": "out", "toNode": 6, "toPort": "b" },
    { "fromNode": 0, "fromPort": "out", "toNode": 6, "toPort": "a" },
    { "fromNode": 2, "fromPort": "out", "toNode": 6, "toPort": "amount" },
    { "fromNode": 6, "fromPort": "out", "toNode": 7, "toPort": "in" }
  ]
}
