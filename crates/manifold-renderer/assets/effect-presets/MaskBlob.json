{
  "version": 2,
  "name": "MaskBlob",
  "presetMetadata": {
    "id": "MaskBlob",
    "displayName": "Blob Mask",
    "category": "Spatial",
    "oscPrefix": "maskBlob",
    "available": false,
    "isLineBased": false,
    "params": [
      { "id": "threshold", "name": "Threshold", "min": 0.0, "max": 1.0, "defaultValue": 0.5, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F2" },
      { "id": "denoise", "name": "Denoise", "min": 0.0, "max": 3.0, "defaultValue": 1.0, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F2" },
      { "id": "min_area", "name": "Min Area", "min": 0.0, "max": 0.25, "defaultValue": 0.001, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F3" },
      { "id": "max_area", "name": "Max Area", "min": 0.01, "max": 1.0, "defaultValue": 0.8, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F2" },
      { "id": "max_blobs", "name": "Max Blobs", "min": 1.0, "max": 32.0, "defaultValue": 8.0, "wholeNumbers": true, "isToggle": false, "isTrigger": false, "formatString": "F0" },
      { "id": "smoothing", "name": "Smoothing", "min": 0.0, "max": 0.5, "defaultValue": 0.06, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F2" },
      { "id": "retention", "name": "Retention", "min": 0.0, "max": 1.0, "defaultValue": 0.15, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F2" },
      { "id": "selection", "name": "Selection", "min": 0.0, "max": 1.0, "defaultValue": 0.0, "wholeNumbers": true, "isToggle": false, "isTrigger": false, "valueLabels": ["All", "Largest"], "formatString": "F0" },
      { "id": "expand", "name": "Expand", "min": -32.0, "max": 32.0, "defaultValue": 0.0, "wholeNumbers": true, "isToggle": false, "isTrigger": false, "formatString": "F0" },
      { "id": "feather", "name": "Feather", "min": 0.0, "max": 8.0, "defaultValue": 1.0, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F2" },
      { "id": "invert", "name": "Invert", "min": 0.0, "max": 1.0, "defaultValue": 0.0, "wholeNumbers": false, "isToggle": true, "isTrigger": false, "formatString": "F0" },
      { "id": "amount", "name": "Amount", "min": 0.0, "max": 1.0, "defaultValue": 1.0, "wholeNumbers": false, "isToggle": false, "isTrigger": false, "formatString": "F2" }
    ],
    "bindings": [
      { "id": "threshold", "label": "Threshold", "defaultValue": 0.5, "target": { "kind": "node", "nodeId": "detect", "param": "threshold" }, "convert": { "type": "Float" } },
      { "id": "denoise", "label": "Denoise", "defaultValue": 1.0, "target": { "kind": "node", "nodeId": "denoise_h", "param": "radius" }, "convert": { "type": "Float" } },
      { "id": "denoise", "label": "Denoise", "defaultValue": 1.0, "target": { "kind": "node", "nodeId": "denoise_v", "param": "radius" }, "convert": { "type": "Float" } },
      { "id": "min_area", "label": "Min Area", "defaultValue": 0.001, "target": { "kind": "node", "nodeId": "detect", "param": "min_area" }, "convert": { "type": "Float" } },
      { "id": "max_area", "label": "Max Area", "defaultValue": 0.8, "target": { "kind": "node", "nodeId": "detect", "param": "max_area" }, "convert": { "type": "Float" } },
