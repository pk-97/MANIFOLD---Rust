    { "id": 6, "nodeId": "tracker", "typeId": "node.track_regions", "handle": "tracker", "params": { "smoothing_seconds": { "type": "Float", "value": 0.06 }, "retention_seconds": { "type": "Float", "value": 0.15 } }, "title": "Track Regions" },
