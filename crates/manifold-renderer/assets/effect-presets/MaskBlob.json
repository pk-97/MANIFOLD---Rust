    { "id": 1, "nodeId": "brightness", "typeId": "node.channel_mixer", "handle": "brightness", "params": { "row0": { "type": "Vec4", "value": [0.2126, 0.7152, 0.0722, 0.0] }, "row1": { "type": "Vec4", "value": [0.2126, 0.7152, 0.0722, 0.0] }, "row2": { "type": "Vec4", "value": [0.2126, 0.7152, 0.0722, 0.0] }, "row3": { "type": "Vec4", "value": [0.0, 0.0, 0.0, 1.0] } }, "title": "Brightness" },
