{
  "version": 2,
  "name": "CodeTerminal",
  "description": "Code-shaped dithering reconstructs the source image in terminal text. Erosion replaces crisp character cells; Tonal Bias chooses highlights or shadows first. Source changes trigger local typing and brief data-character edits; still content settles. Layout selects Single or tmux-style panes. Activity zero holds the characters.",
  "presetMetadata": {
    "id": "CodeTerminal",
    "displayName": "Code Terminal",
    "category": "Stylize",
    "oscPrefix": "code_terminal",
    "available": true,
    "isLineBased": false,
    "params": [
      {
        "id": "erosion",
        "name": "Erosion",
        "min": 0.0,
        "max": 1.0,
        "defaultValue": 1.0,
        "wholeNumbers": false,
        "isToggle": false,
        "isTrigger": false,
        "formatString": "F2"
      },
      {
        "id": "text_size",
        "name": "Text Size",
        "min": 8.0,
        "max": 48.0,
        "defaultValue": 16.0,
        "wholeNumbers": false,
        "isToggle": false,
        "isTrigger": false,
        "formatString": "F0"
      },
      {
        "id": "activity",
        "name": "Activity",
        "min": 0.0,
        "max": 4.0,
        "defaultValue": 1.0,
        "wholeNumbers": false,
        "isToggle": false,
        "isTrigger": false,
        "formatString": "F2"
      },
      {
        "id": "tonal_bias",
        "name": "Tonal Bias",
        "min": -1.0,
        "max": 1.0,
        "defaultValue": 0.0,
        "wholeNumbers": false,
        "isToggle": false,
        "isTrigger": false,
        "formatString": "F2"
      },
      {
        "id": "colour",
        "name": "Colour",
        "min": 0.0,
        "max": 2.0,
        "defaultValue": 1.0,
        "wholeNumbers": true,
        "isToggle": false,
        "isTrigger": false,
        "formatString": "F0",
        "valueLabels": [
          "Source",
          "Green",
          "Amber"
        ]
      },
      {
        "id": "layout",
        "name": "Layout",
        "min": 0.0,
        "max": 3.0,
        "defaultValue": 0.0,
        "wholeNumbers": true,
        "isToggle": false,
        "isTrigger": false,
        "formatString": "F0",
        "valueLabels": [
          "Single",
          "Vertical Split",
          "Horizontal Split",
          "Four Panes"
        ]
      },
      {
        "id": "detail_reactivity",
        "name": "Detail Reactivity",
        "min": 0.0,
        "max": 1.0,
        "defaultValue": 0.55,
        "wholeNumbers": false,
        "isToggle": false,
        "isTrigger": false,
        "formatString": "F2"
      }
    ],
    "bindings": [
      {
        "id": "erosion",
        "label": "Erosion",
        "defaultValue": 1.0,
        "target": {
          "kind": "node",
          "nodeId": "erosion_low",
          "param": "a"
        },
        "convert": {
          "type": "Float"
        }
      },
      {
        "id": "text_size",
        "label": "Text Size",
        "defaultValue": 16.0,
        "target": {
          "kind": "node",
          "nodeId": "terminal",
          "param": "text_size"
        },
        "convert": {
          "type": "Float"
        }
      },
      {
        "id": "activity",
        "label": "Activity",
        "defaultValue": 1.0,
        "target": {
          "kind": "node",
          "nodeId": "terminal",
          "param": "activity"
        },
        "convert": {
          "type": "Float"
        }
      },
      {
        "id": "tonal_bias",
        "label": "Tonal Bias",
        "defaultValue": 0.0,
        "target": {
          "kind": "node",
          "nodeId": "bias",
          "param": "a"
        },
        "convert": {
