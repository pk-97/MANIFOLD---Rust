        "label": "Colour",
        "defaultValue": 1.0,
        "target": {
          "kind": "node",
          "nodeId": "palette",
          "param": "selector"
        },
        "convert": {
          "type": "Float"
        }
      },
      {
        "id": "layout",
        "label": "Layout",
        "defaultValue": 0.0,
        "target": {
          "kind": "node",
          "nodeId": "terminal",
          "param": "layout"
        },
        "convert": {
          "type": "EnumRound"
        }
      },
      {
        "id": "detail_reactivity",
        "label": "Detail Reactivity",
        "defaultValue": 0.55,
        "target": {
          "kind": "node",
          "nodeId": "terminal",
          "param": "detail_reactivity"
        },
        "convert": {
          "type": "Float"
        }
      }
    ]
