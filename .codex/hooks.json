{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|spawn_agent|collaborationspawn_agent|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --path-format=absolute --git-common-dir)/../.codex/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
