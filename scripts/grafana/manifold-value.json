      "id": 12,
      "type": "barchart",
      "title": "Work-class threshold audit — output tokens per call",
      "description": "The real-work split assumes a valley at ≤16 output tokens (the permission-classifier signature). If the buckets next to the threshold fill in, the heuristic broke and the overhead split is lying.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "manifold-litellm-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 85,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH b AS (\n  SELECT\n    CASE\n      WHEN output_tokens <= 16  THEN '0–16'\n      WHEN output_tokens <= 32  THEN '17–32'\n      WHEN output_tokens <= 64  THEN '33–64'\n      WHEN output_tokens <= 128 THEN '65–128'\n      WHEN output_tokens <= 512 THEN '129–512'\n      ELSE '513+'\n    END AS bucket,\n    CASE\n      WHEN output_tokens <= 16  THEN 1\n      WHEN output_tokens <= 32  THEN 2\n      WHEN output_tokens <= 64  THEN 3\n      WHEN output_tokens <= 128 THEN 4\n      WHEN output_tokens <= 512 THEN 5\n      ELSE 6\n    END AS sort_order,\n    provider\n  FROM manifold_fleet_usage\n  WHERE $__timeFilter(ts)\n)\nSELECT bucket AS \"Bucket\",\n       count(*) FILTER (WHERE provider = 'Anthropic') AS \"Anthropic\",\n       count(*) FILTER (WHERE provider = 'Kimi')      AS \"Kimi\",\n       count(*) FILTER (WHERE provider = 'Z.AI')      AS \"Z.AI\",\n       count(*) FILTER (WHERE provider = 'OpenCode')  AS \"OpenCode\"\nFROM b\nGROUP BY bucket, sort_order\nORDER BY sort_order",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "manifold-litellm-pg"
          },
          "editorMode": "code"
        }
      ]
