<?xml version="1.0"?>
<materialx version="1.39" fileprefix="./">
  <open_pbr_surface type="surfaceshader" name="LavaCrust_2K_JPG_OpenPbrSurface">
    <input nodename="LavaCrust_2K_JPG_Color" type="color3" name="base_color" />
    <input nodename="NormalMap" type="vector3" name="geometry_normal" />
    <input nodename="LavaCrust_2K_JPG_Roughness" type="float" name="specular_roughness" />
    <input nodename="LavaCrust_2K_JPG_Emission" type="color3" name="emission_color" />
    <input type="float" name="emission_luminance" value="1.0" />
  </open_pbr_surface>
  <surfacematerial type="material" name="LavaCrust_2K_JPG">
    <input nodename="LavaCrust_2K_JPG_OpenPbrSurface" type="surfaceshader" name="surfaceshader" />
    <input nodename="displacement" type="displacementshader" name="displacementshader" />
  </surfacematerial>
  <hextiledimage type="color3" name="LavaCrust_2K_JPG_Color">
    <input value="LavaCrust_2K-JPG_Color.jpg" colorspace="srgb_texture" type="filename" name="file" />
    <input value="1.0, 1.0" type="vector2" name="tiling" />
    <input name="realworldimagesize" type="vector2" value="1.0, 1.0" unit="meter" unittype="distance" />
  </hextiledimage>
  <tiledimage type="color3" name="LavaCrust_2K_JPG_Emission">
    <input value="LavaCrust_2K-JPG_Emission.jpg" colorspace="srgb_texture" type="filename" name="file" />
    <input value="1.0, 1.0" type="vector2" name="uvtiling" />
  </tiledimage>
  <tiledimage type="float" name="LavaCrust_2K_JPG_Displacement">
    <input value="LavaCrust_2K-JPG_Displacement.jpg" type="filename" name="file" />
    <input value="1.0, 1.0" type="vector2" name="uvtiling" />
  </tiledimage>
  <displacement type="displacementshader" name="displacement">
    <input nodename="LavaCrust_2K_JPG_Displacement" type="float" name="displacement" />
    <input name="scale" type="float" value="0.03" unit="meter" unittype="distance" />
  </displacement>
  <tiledimage type="vector3" name="LavaCrust_2K_JPG_NormalGL">
    <input value="LavaCrust_2K-JPG_NormalGL.jpg" type="filename" name="file" />
    <input value="1.0, 1.0" type="vector2" name="uvtiling" />
  </tiledimage>
  <normalmap type="vector3" name="NormalMap">
    <input nodename="LavaCrust_2K_JPG_NormalGL" type="vector3" name="in" />
    <input value="1.0" type="float" name="scale" />
  </normalmap>
  <tiledimage type="float" name="LavaCrust_2K_JPG_Roughness">
    <input value="LavaCrust_2K-JPG_Roughness.jpg" type="filename" name="file" />
    <input value="1.0, 1.0" type="vector2" name="uvtiling" />
  </tiledimage>
</materialx>
