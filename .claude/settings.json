{
  "permissions": {
    "allow": [
      "Bash(git commit -m *)",
      "Bash(cargo metadata *)",
      "Bash(cargo xtask install *)",
      "Bash(cargo xtask bundle *)",
      "Bash(cargo xtask install)",
      "Bash(cargo xtask bundle)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(sort *)",
      "Bash(jq *)",
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(cargo clippy)",
      "Bash(cargo clippy *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(scripts/gpu_queue.py -- cargo test *)",
      "Bash(cargo run -p manifold-nodes --bin check-presets)",
      "Bash(cargo run -p manifold-nodes --bin check-presets *)",
      "Bash(unzip -p *)",
      "Bash(unzip -l *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-time.py\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/permission-request-guard.py\""
          }
        ]
      }
    ]
  }
}
