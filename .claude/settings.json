{
  "permissions": {
    "allow": [
      "Bash(git commit -m *)",
      "Bash(cargo metadata *)",
      "Bash(cargo xtask install *)",
      "Bash(cargo xtask bundle *)",
      "Bash(cargo xtask install)",
      "Bash(cargo xtask bundle)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(sort *)",
      "Bash(jq *)",
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(cargo clippy)",
      "Bash(cargo clippy *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(scripts/gpu_queue.py -- cargo test *)",
      "Bash(scripts/gpu_queue.py -- scripts/gpu_proofs_gate.py *)",
      "Bash(scripts/gpu_queue.py -- scripts/landing_gate.py *)",
      "Bash(cargo run -p manifold-renderer --bin check-presets)",
      "Bash(cargo run -p manifold-renderer --bin check-presets *)",
      "Bash(unzip -p *)",
      "Bash(unzip -l *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" local-time.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" session-end-worktree-scrub.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" conversation-recall-hook.py response-style-hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" preToolUseBash.py closes-trailer-guard.py context-nudge.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" worktree-guard.py memory-history-guard.py bare-id-guard.py ignored-test-guard.py context-nudge.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" agent-launch-guard.py agent-worktree-isolation-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" test-summary-guard.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" permission-request-guard.py"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_telemetry.py\" permission-request-guard.py"
          }
        ]
      }
    ]
  }
}
