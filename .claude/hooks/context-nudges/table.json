{
  "_doc": "Path-triggered context injection: first Edit/Write touching a matching path this session injects the snippet (once per topic). Consumed by .claude/hooks/context-nudge.py. Add an invariant = add a line to a snippet or a glob here, never a new hook.",
  "nudges": [
    {
      "topic": "wgsl-shaders",
      "globs": ["*.wgsl", "*shaders/*", "*gpu_encoder*", "*manifold-gpu/*"],
      "snippet": "gpu-shader-gotchas.md"
    },
    {
      "topic": "ui-invariants",
      "globs": ["*crates/manifold-ui/*", "*crates/manifold-ui-paint/*", "*ui_bridge/*", "*app_render.rs"],
      "snippet": "ui-invariants.md"
    },
    {
      "topic": "effect-runtime",
      "globs": ["*chain_dispatch*", "*chain_spec*", "*content_pipeline.rs", "*manifold-node-engine/src/runtime/*", "*manifold-node-engine/src/exec/*", "*manifold-node-engine/src/freeze/*"],
      "snippet": "effect-runtime-invariants.md"
    },
    {
      "topic": "graph-authoring",
      "globs": ["*node_graph/primitives/*", "*node_graph/gltf_load*", "*manifold-node-engine/src/primitives/*", "*manifold-nodes-water/src/primitives/*", "*manifold-water-rigid/src/primitives/*", "*manifold-water-liquid/src/primitives/*", "*manifold-water-gpu-flip/src/primitives/*", "*presets/*.json", "*composites/*"],
      "snippet": "graph-authoring-rules.md"
    },
    {
      "topic": "landing",
      "command_globs": ["*git merge*", "*git push*origin main*", "*landing_gate.py*", "*land_branch.py*", "*dev.py gate*", "*dev.py land*"],
      "snippet": "landing-protocol.md"
    },
    {
      "topic": "tool-inventory",
      "globs": ["*/scripts/*.py", "*/scripts/*.sh"],
      "snippet": "tool-inventory.md"
    },
    {
      "topic": "workspace-test",
      "command_globs": ["*cargo*--workspace*", "*cargo test --all*"],
      "snippet": "test-scope.md"
    }
  ]
}
