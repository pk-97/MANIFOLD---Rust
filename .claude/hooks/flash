#!/usr/bin/env python3
"""flash — one-shot API tool (AGENT_ROUTING R6-B "one-shot API tool").

Usage:
  flash "prompt text"                  # inline prompt
  flash -f prompt.txt                  # prompt from file
  cat file | flash                     # prompt from stdin
  flash --max-tokens 16000 "..."       # starting budget (default 8192)
  flash --model glm-4.7                # default; any proxy model id works
  flash --system "you are..." "..."    # optional system message

Prints the model's content to stdout; usage/cost line to stderr.
Exit 0 = content returned. Exit 3 = empty content after budget escalations.
Exit 2 = request/transport error.

DEFAULT = glm-4.7 (Peter, 2026-07-25): DeepSeek V4 Flash AND Pro lack the
context to complete one-shot tool calls — they reason unconditionally
(D-54, reasoning-off ignored upstream) and can burn the ENTIRE completion
budget on reasoning, returning empty content. glm-4.7 has no reasoning
overhead and is 1x on the z.ai plan, so it is the one-shot seat. The
escalation below remains for any DeepSeek call passed via --model.

Key: `cc-fleet keyget kimi-code` (k3-lead virtual key allows all proxy models;
lane spend bills under the spawning seat, itemized per-model). Never put the
key in env or argv — read it subprocess-side only.
"""
import json
import subprocess
import sys
import urllib.request

PROXY = "http://127.0.0.1:4000/v1/chat/completions"


def main() -> int:
    args = sys.argv[1:]
    model = "glm-4.7"
    max_tokens = 8192
    cap = 32768
    system = None
    prompt_parts = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-f":
            i += 1
            prompt_parts.append(open(args[i]).read())
        elif a == "--max-tokens":
            i += 1
            max_tokens = int(args[i])
        elif a == "--max-tokens-cap":
            i += 1
            cap = int(args[i])
        elif a == "--model":
            i += 1
            model = args[i]
        elif a == "--system":
            i += 1
            system = args[i]
        else:
            prompt_parts.append(a)
        i += 1
    prompt = " ".join(p.strip() for p in prompt_parts if p.strip())
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if not prompt:
        print(__doc__, file=sys.stderr)
        return 2

    key = subprocess.run(
        ["cc-fleet", "keyget", "kimi-code"], capture_output=True, text=True, check=True
    ).stdout.strip()

    messages = ([{"role": "system", "content": system}] if system else []) + [
        {"role": "user", "content": prompt}
    ]
    budget = max_tokens
    while True:
        body = {"model": model, "max_tokens": budget, "messages": messages}
        req = urllib.request.Request(
            PROXY,
            data=json.dumps(body).encode(),
            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
        )
        try:
            resp = json.load(urllib.request.urlopen(req, timeout=600))
        except Exception as e:  # transport/HTTP — surface and stop
            # Quota exhaustion on the default seat → one retry on the
            # kimi fast tier (verified working one-shot path 2026-07-25 —
            # reasons a little but EMITS; most window headroom of any seat).
            # DeepSeek is NOT a fallback: unconditional reasoning is the
            # wall this tool routes around (D-54).
            if model == "glm-4.7":
                print(f"flash: {model} failed ({e}) — falling back to kimi-for-coding", file=sys.stderr)
                model = "kimi-for-coding"
                continue
            print(f"flash: request failed: {e}", file=sys.stderr)
            return 2
        choice = resp["choices"][0]
        content = (choice["message"].get("content") or "").strip()
        usage = resp.get("usage", {})
        details = usage.get("completion_tokens_details") or {}
        reasoning = details.get("reasoning_tokens", 0)
        print(f"flash: usage={usage}", file=sys.stderr)
        if content:
            print(content)
            return 0
        # Empty content. Reasoning exhaustion = all completion tokens were
        # reasoning and the model hit the budget mid-thought (finish_reason
        # 'length'). Anything else is a real empty answer — retrying won't help.
        if reasoning >= usage.get("completion_tokens", 0) and budget < cap:
            budget = min(budget * 2, cap)
            print(f"flash: empty content (reasoning exhausted budget) — retrying at {budget}", file=sys.stderr)
            continue
        print(f"flash: empty content (finish_reason={choice.get('finish_reason')}, reasoning_tokens={reasoning})", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
